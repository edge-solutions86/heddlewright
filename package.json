{
  "name": "heddlewright",
  "version": "0.1.0",
  "private": true,
  "description": "Draft, card deck and cloth analysis tooling for dobby and Jacquard weaving sheds",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.11"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "coverage": "vitest run --coverage",
    "verify": "node scripts/verify.mjs",
    "smoke": "node scripts/smoke.mjs",
    "bench": "node scripts/bench.mjs",
    "surface": "node scripts/surface.mjs",
    "surface:check": "node scripts/surface.mjs --check"
  },
  "devDependencies": {
    "@eslint/js": "9.19.0",
    "@vitest/coverage-v8": "3.0.5",
    "eslint": "9.19.0",
    "globals": "15.14.0",
    "prettier": "3.4.2",
    "vitest": "3.0.5"
  },
  "keywords": [
    "weaving",
    "jacquard",
    "dobby",
    "loom",
    "textile",
    "drawdown"
  ],
  "files": [
    "src",
    "bin",
    "docs",
    "README.md"
  ]
}
